<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/layoutImageToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackImage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_cancel"
            android:src="@drawable/ic_close"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvImageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:text="Photo"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnImageInfo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Info"
            android:src="@drawable/ic_info"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnImageShare"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Share"
            android:src="@drawable/ic_share"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnImageFavorite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Favorite"
            android:src="@drawable/ic_star_outline"
            app:tint="#F59E0B" />

        <ImageButton
            android:id="@+id/btnImageVault"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Vault"
            android:src="@drawable/ic_vault"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnImageDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete"
            android:src="@drawable/ic_delete"
            app:tint="#EF4444" />
    </LinearLayout>

    <!-- Main Fullscreen Image -->
    <ImageView
        android:id="@+id/ivFullImage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:contentDescription="Photo View"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@id/layoutImageInfo"
        app:layout_constraintTop_toBottomOf="@id/layoutImageToolbar" />

    <!-- Bottom Info Bar -->
    <LinearLayout
        android:id="@+id/layoutImageInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvImageDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
