<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardVideo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Video Thumbnail Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#1E293B">

            <ImageView
                android:id="@+id/ivThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop" />

            <!-- Selection Checkbox -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbSelect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Duration Badge -->
            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_pill_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="00:15" />

            <!-- Top Actions: Info & Favorite -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnInfo"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_pill_badge"
                    android:backgroundTint="#80000000"
                    android:clickable="true"
                    android:focusable="false"
                    android:padding="8dp"
                    android:contentDescription="View Metadata"
                    android:src="@drawable/ic_info"
                    app:tint="#FFFFFF" />

                <!-- Favorite Star Indicator -->
                <ImageButton
                    android:id="@+id/btnFavorite"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_pill_badge"
                    android:backgroundTint="#80000000"
                    android:clickable="true"
                    android:focusable="false"
                    android:padding="8dp"
                    android:contentDescription="@string/filter_favorites"
                    android:src="@drawable/ic_star_outline"
                    app:tint="#FFFFFF" />
            </LinearLayout>
        </FrameLayout>

        <!-- Video Metadata Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="2026-08-23_14-30-45.mp4" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10sp"
                    tools:text="Aug 23, 14:30" />

                <TextView
                    android:id="@+id/tvSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10sp"
                    tools:text="24.5 MB" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
