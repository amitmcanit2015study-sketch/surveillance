<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="?attr/colorOutlineVariant" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/metadata_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- Metadata Items -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Filename -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/meta_filename"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/tvMetaFilename"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="2026-08-23_14-30-45.mp4" />

        <View android:layout_width="match_parent" android:layout_height="8dp" />

        <!-- Timestamp -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/meta_date"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/tvMetaDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            tools:text="Sunday, August 23, 2026 at 14:30:45" />

        <View android:layout_width="match_parent" android:layout_height="8dp" />

        <!-- Duration & Size Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/meta_duration"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvMetaDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    tools:text="00:03:42" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/meta_filesize"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvMetaSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    tools:text="38.2 MB" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="8dp" />

        <!-- Resolution & Codec Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/meta_resolution"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvMetaResolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    tools:text="1920 x 1080 (FHD)" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/meta_codec"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvMetaCodec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    tools:text="H.264 / AAC" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="8dp" />

        <!-- GPS Location Tag -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/meta_location"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/tvMetaLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            tools:text="28.6139° N, 77.2090° E" />

        <View android:layout_width="match_parent" android:layout_height="8dp" />

        <!-- File Path -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/meta_path"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/tvMetaPath"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            tools:text="/storage/emulated/0/Movies/SecurityRecorder/2026-08-23_14-30-45.mp4" />
    </LinearLayout>

    <Button
        android:id="@+id/btnCloseMetadata"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/action_cancel" />
</LinearLayout>
