<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121214"
    android:orientation="vertical">

    <!-- Top Toolbar with Back Arrow -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/aboutToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#121214"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="#FFFFFF"
        app:title="About"
        app:titleTextColor="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Center App Icon in rounded squircle -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#1E1E24"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="#2E2E38"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_splash_surveillance" />
            </com.google.android.material.card.MaterialCardView>

            <!-- App Name & Version -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/app_version_name"
                android:textColor="#8E8E93"
                android:textSize="13sp" />

            <!-- Description & Developer Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#1A1A1E"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#2A2A34"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.35"
                        android:text="@string/about_description"
                        android:textColor="#D1D1D6"
                        android:textSize="13.5sp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="#2A2A34" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/developer_name"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/company_name"
                        android:textColor="#8E8E93"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/company_email"
                        android:textColor="#8E8E93"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons: Share APK & Download APK -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <!-- Share APK Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAboutShareApp"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#2C2C34"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/share_app"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    app:cornerRadius="25dp"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="#FFFFFF" />

                <!-- Download APK Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAboutDownloadApk"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#2C2C34"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/download_apk"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    app:cornerRadius="25dp"
                    app:icon="@drawable/ic_cloud_download"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="#FFFFFF" />
            </LinearLayout>

            <!-- Send Feedback Button (Pill shaped outline) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendFeedback"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/send_feedback"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                app:cornerRadius="25dp"
                app:strokeColor="#3A3A46"
                app:strokeWidth="1.2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Footer Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="8dp"
                android:text="@string/about_footer"
                android:textColor="#71717A"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
